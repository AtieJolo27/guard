# Set these in your shell, or use Node --env-file=.env.playwright.
E2E_LOCAL_URL=http://127.0.0.1:8003
# Optional local QA admin credentials; never use a student's account.
E2E_LOCAL_LOGIN=
E2E_LOCAL_PASSWORD=
# By default, a temporary test server/database is created at this URL.
E2E_TEST_URL=http://127.0.0.1:8010
# For an existing staging environment set E2E_REMOTE_TEST=1 and its URL/QA credentials.
# E2E_REMOTE_TEST=1
# E2E_TEST_URL=https://your-test-host.example
# E2E_TEST_LOGIN=
# E2E_TEST_PASSWORD=
E2E_VISUAL_TOLERANCE=0.02
