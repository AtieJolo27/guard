{
  "info": {
    "name": "SDVRS security smoke checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only against an isolated QA database. Uses cookie sessions and CSRF. Does not submit incidents or send email. Set base_url, admin_login and admin_password locally."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "admin_login",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "secret"
    },
    {
      "key": "csrf_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Obtain session and CSRF",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login page',()=>pm.response.to.have.status(200));",
              "const match=pm.response.text().match(/name=\"csrf-token\" content=\"([^\"]+)\"/);",
              "if(match) pm.collectionVariables.set('csrf_token',match[1]);",
              "pm.test('CSRF token present',()=>pm.expect(pm.collectionVariables.get('csrf_token')).to.be.ok);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Reject invalid CSRF",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "qa@example.test",
              "type": "text"
            },
            {
              "key": "password",
              "value": "unused",
              "type": "text"
            },
            {
              "key": "_token",
              "value": "invalid",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CSRF rejected',()=>pm.response.to.have.status(419));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Authenticate QA admin",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "{{admin_login}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{admin_password}}",
              "type": "text"
            },
            {
              "key": "_token",
              "value": "{{csrf_token}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authenticated redirect',()=>pm.response.to.have.status(302));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Refresh CSRF after login",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/admin/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin dashboard',()=>pm.response.to.have.status(200));",
              "const match=pm.response.text().match(/name=\"csrf-token\" content=\"([^\"]+)\"/);",
              "if(match) pm.collectionVariables.set('csrf_token',match[1]);",
              "pm.test('Private cache policy',()=>pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
              "pm.test('Anti framing',()=>pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Reject malformed case ID",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/admin/cases/not-a-number"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Not found',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Reject array search input",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/admin/cases?search%5B%5D=bad"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Validation error',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Logout invalidates session",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/logout",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "_token",
              "value": "{{csrf_token}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout redirect',()=>pm.response.to.have.status(302));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Reject access after logout",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/admin/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Forbidden',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}